generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "debian-openssl-3.0.x", "linux-musl"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Enums
enum Role {
    OWNER
    TENANT
    ADMIN
}

enum LeaseStatus {
    ACTIVE
    ENDED
}

enum InvoiceStatus {
    PENDING
    PARTIAL
    PAID
    LATE
}

enum PaymentStatus {
    INITIATED
    SUCCESS
    FAILED
}

enum PaymentMethod {
    CASH
    BANK_TRANSFER
    MOBILE_BANKING // bKash, Nagad, Rocket
    CHEQUE
}

// Models
model User {
    id           String    @id @default(uuid())
    email        String    @unique
    passwordHash String    @map("password_hash")
    role         Role
    createdAt    DateTime  @default(now()) @map("created_at")
    updatedAt    DateTime  @updatedAt @map("updated_at")
    createdBy    String?   @map("created_by") // FK to User.id — nullable for seed/admin
    deletedAt    DateTime? @map("deleted_at")

    properties     Property[]
    leasesAsTenant Lease[]        @relation("TenantLeases")
    ownedLeases    Lease[] @relation("OwnerLeases")
    refreshTokens  RefreshToken[]
    auditLogs      AuditLog[]

    @@index([email])
    @@index([role])
    @@index([deletedAt])
    @@map("users")
}

model Property {
    id        String    @id @default(uuid())
    ownerId   String    @map("owner_id")
    name      String
    address   String
    createdAt DateTime  @default(now()) @map("created_at")
    updatedAt DateTime  @updatedAt @map("updated_at")
    createdBy String    @map("created_by")
    deletedAt DateTime? @map("deleted_at")

    owner User   @relation(fields: [ownerId], references: [id])
    leases Lease[] @relation("PropertyLeases")
    units Unit[]

    @@index([ownerId])
    @@index([ownerId, deletedAt])
    @@map("properties")
}

model Unit {
    id         String    @id @default(uuid())
    propertyId String    @map("property_id")
    unitNumber String    @map("unit_number")
    rentAmount Decimal   @db.Decimal(12, 2) @map("rent_amount")
    createdAt  DateTime  @default(now()) @map("created_at")
    updatedAt  DateTime  @updatedAt @map("updated_at")
    createdBy  String    @map("created_by")
    deletedAt  DateTime? @map("deleted_at")

    property Property @relation(fields: [propertyId], references: [id])
    leases   Lease[]

    @@unique([propertyId, unitNumber])
    @@index([propertyId])
    @@index([deletedAt])
    @@map("units")
}

model Lease {
    id              String      @id @default(uuid())
    propertyId      String      @map("property_id")
    unitId          String      @map("unit_id")
    tenantId        String      @map("tenant_id")
    ownerId         String      @map("owner_id")
    startDate       DateTime    @map("start_date")
    endDate         DateTime?   @map("end_date")
    monthlyRent     Decimal     @db.Decimal(12, 2) @map("monthly_rent")
    billingDay      Int         @map("billing_day")
    status          LeaseStatus @default(ACTIVE)
    createdAt       DateTime    @default(now()) @map("created_at")
    updatedAt       DateTime    @updatedAt @map("updated_at")
    createdBy       String      @map("created_by")
    deletedAt       DateTime?   @map("deleted_at")

    property Property @relation("PropertyLeases", fields: [propertyId], references: [id])
    unit     Unit     @relation(fields: [unitId], references: [id])
    tenant   User     @relation("TenantLeases", fields: [tenantId], references: [id])
    owner    User     @relation("OwnerLeases", fields: [ownerId], references: [id])
    invoices RentInvoice[]

    @@unique([unitId, startDate])
    @@index([tenantId])
    @@index([ownerId])
    @@index([status])
    @@index([deletedAt])
    @@map("leases")
}

model RentInvoice {
    id                String        @id @default(uuid())
    leaseId           String        @map("lease_id")
    ownerId           String        @map("owner_id")
    billingPeriodStart DateTime      @map("billing_period_start")
    billingPeriodEnd   DateTime      @map("billing_period_end")
    totalAmount       Decimal       @db.Decimal(12, 2) @map("total_amount")
    paidAmount        Decimal       @db.Decimal(12, 2) @default(0) @map("paid_amount")
    dueDate           DateTime      @map("due_date")
    status            InvoiceStatus @default(PENDING)
    createdAt         DateTime      @default(now()) @map("created_at")
    updatedAt         DateTime      @updatedAt @map("updated_at")
    createdBy         String        @map("created_by")
    deletedAt         DateTime?     @map("deleted_at")

    lease     Lease     @relation(fields: [leaseId], references: [id])
    payments Payment[]

    @@unique([leaseId, billingPeriodStart])
    @@index([leaseId])
    @@index([ownerId])
    @@index([status])
    @@index([dueDate])
    @@index([deletedAt])
    @@map("rent_invoices")
}

model Payment {
    id               String        @id @default(uuid())
    invoiceId        String        @map("invoice_id")
    ownerId          String        @map("owner_id") // denormalized
    amount           Decimal       @db.Decimal(12, 2)
    method           PaymentMethod
    status           PaymentStatus @default(INITIATED)
    transactionRef   String?       @unique @map("transaction_ref") // external ref
    idempotencyKeyId String?       @unique @map("idempotency_key_id")
    createdAt        DateTime      @default(now()) @map("created_at")
    updatedAt        DateTime      @updatedAt @map("updated_at")
    createdBy        String        @map("created_by")
    // No deletedAt — payments are immutable financial records

    invoice        RentInvoice     @relation(fields: [invoiceId], references: [id])
    idempotencyKey IdempotencyKey? @relation(fields: [idempotencyKeyId], references: [id])

    @@index([invoiceId])
    @@index([ownerId])
    @@index([status])
    @@index([ownerId, status])
    @@map("payments")
}

model RefreshToken {
    id        String   @id @default(uuid())
    tokenHash String   @unique @map("token_hash")
    userId    String   @map("user_id")
    expiresAt DateTime @map("expires_at")
    revokedAt DateTime? @map("revoked_at")
    ipAddress String?  @map("ip_address")
    createdAt DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([expiresAt])
    @@index([revokedAt])
    @@map("refresh_tokens")
}

model IdempotencyKey {
    id            String   @id @default(uuid())
    key           String   @unique
    ownerId       String   @map("owner_id")
    responseHash  String?  @map("response_hash")
    responsePayload Json?  @map("response_payload")
    expiresAt     DateTime @map("expires_at")
    createdAt     DateTime @default(now()) @map("created_at")
    updatedAt     DateTime @updatedAt @map("updated_at")

    payments Payment[]

    @@index([key, ownerId])
    @@index([ownerId])
    @@index([expiresAt])
    @@map("idempotency_keys")
}

model AuditLog {
    id        String   @id @default(uuid())
    userId    String   @map("user_id")
    action    String
    resource  String
    resourceId String? @map("resource_id")
    oldValues Json?    @map("old_values")
    newValues Json?    @map("new_values")
    ipAddress String?  @map("ip_address")
    userAgent String?  @map("user_agent")
    createdAt DateTime @default(now()) @map("created_at")

    user User @relation(fields: [userId], references: [id])

    @@index([userId])
    @@index([action])
    @@index([resource])
    @@index([createdAt])
    @@map("audit_logs")
}
