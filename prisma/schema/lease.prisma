model Lease {
    id          String      @id @default(uuid())
    unitId      String      @map("unit_id")
    tenantId    String      @map("tenant_id")
    ownerId     String      @map("owner_id") // denormalized for query perf
    startDate   DateTime    @map("start_date") @db.Date
    endDate     DateTime?   @map("end_date") @db.Date // nullable = open-ended lease
    monthlyRent Decimal     @map("monthly_rent") @db.Decimal(12, 2)
    billingDay  Int         @map("billing_day") // 1–28, enforced via CHECK
    status      LeaseStatus @default(ACTIVE)
    createdAt   DateTime    @default(now()) @map("created_at")
    updatedAt   DateTime    @updatedAt @map("updated_at")
    createdBy   String      @map("created_by")
    deletedAt   DateTime?   @map("deleted_at")

    unit         Unit          @relation(fields: [unitId], references: [id])
    tenant       User          @relation("TenantLeases", fields: [tenantId], references: [id])
    rentInvoices RentInvoice[]

    @@index([ownerId])
    @@index([tenantId])
    @@index([unitId])
    @@index([status])
    @@index([ownerId, status])
    @@map("leases")
}
