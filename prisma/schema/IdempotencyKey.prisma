model IdempotencyKey {
    id           String   @id @default(uuid())
    ownerId      String   @map("owner_id")
    key          String   @unique // client-supplied UUID in header
    responseHash String?  @map("response_hash") // SHA256 of response payload
    expiresAt    DateTime @map("expires_at") // 24h TTL typical
    createdAt    DateTime @default(now()) @map("created_at")

    payment Payment?

    @@index([ownerId, key])
    @@index([expiresAt]) // for cleanup job
    @@map("idempotency_keys")
}
