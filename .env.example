# .env.example — copy to .env and fill in values

NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://rentos:rentos_secret@localhost:5432/rentos"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT — use long random strings in production
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-minimum-32-characters-long
JWT_REFRESH_SECRET=change-me-minimum-32-characters-long-different
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=12

# Idempotency
IDEMPOTENCY_KEY_TTL_HOURS=24